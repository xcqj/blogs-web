# blog-web 环境变量样例（复制为 .env 后填本地值；勿写入真实密钥）
# NUXT_APP_CLIENT_ID：web 客户端的 client_id，由 RuoYi-Vue-Plus/docs/blog_s9_web_client.sql 建立，
#   执行其验证段获取（与 plus-ui 的 pc 记录会话隔离，grantType 仅 password）。
NUXT_APP_CLIENT_ID=

# 后端开启全局接口加密(api-decrypt.enabled=true)且 /auth/login 带 @ApiEncrypt 时，登录需按加密链路走。
# 生产必须更换为独立密钥对；本地可用与后端 application.yml 配对的演示密钥（勿提交真实值）。
# 前端加密公钥（请求方向）——与后端 privateKey 配对；flat 键 rsaPublicKey → 环境变量 NUXT_RSA_PUBLIC_KEY
NUXT_RSA_PUBLIC_KEY=
# 前端解密私钥（响应方向）——与后端 publicKey 配对；flat 键 rsaPrivateKey → 环境变量 NUXT_RSA_PRIVATE_KEY
NUXT_RSA_PRIVATE_KEY=
